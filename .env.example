# ══════════════════════════════════════════════════════
# CoinDCX Futures Bot (.env.example)
# Copy to .env and fill in your values. Never commit .env.
# ══════════════════════════════════════════════════════

# ── Mode ──────────────────────────────────────────────
PAPER_TRADING=true          # false = real orders on CoinDCX

# ── CoinDCX API ───────────────────────────────────────
# Create keys at https://coindcx.com/settings/api
# Enable: Futures Trading permission
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ── Symbols (comma-separated) ─────────────────────────
DCX_SYMBOLS=B-ETH_USDT,B-SOL_USDT,B-HYPE_USDT,B-AAVE_USDT,B-ZEC_USDT,B-UNI_USDT

# ── Risk ──────────────────────────────────────────────
CAPITAL_USDT=1000           # Total capital allocated to this bot
RISK_PCT=1.0                # % of capital at risk per trade
MAX_POSITIONS=4             # Max open positions at once
LEVERAGE=3                  # Futures leverage (conservative: 2-3x)
MAX_DAILY_LOSS_PCT=5.0      # Stop new trades if daily loss exceeds this %

# ── Strategy ──────────────────────────────────────────
EMA_PERIOD=50               # EMA length for trend direction
ATR_PERIOD=20               # ATR length for volatility + SL/TP
ATR_SL_MULT=1.5             # SL = entry ± mult * ATR
ATR_TP_MULT=3.0             # TP = entry ∓ mult * ATR  (2:1 R:R)
PRIMARY_TF=4h               # Signal timeframe (4h recommended)
POLL_INTERVAL=300           # Seconds between candle checks (5 min)

# ── Telegram ──────────────────────────────────────────
# Step 1: Message @BotFather → /newbot → copy BOT_TOKEN
# Step 2: Start your bot, send /chatid → copy your user ID
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Legacy Polymarket (not used by CoinDCX bot) ───────
PAPER_TRADING=true
BANKROLL=1000
RISK_PCT=2.0
MAX_OPEN_TRADES=3
CVD_THRESHOLD=5.0
WHALE_THRESHOLD=50000
SIGNAL_COOLDOWN=60
MAX_DAILY_LOSS_PCT=10.0
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
