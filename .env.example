# ── Mode ─────────────────────────────────────────────────────────────
PAPER_TRADING=true          # Set to false for live trading (requires API keys below)

# ── Bankroll & Risk ───────────────────────────────────────────────────
BANKROLL=1000               # Starting paper bankroll in USDC
RISK_PCT=2.0                # % of bankroll risked per trade (e.g. 2 = 2%)
MAX_OPEN_TRADES=3           # Max simultaneous open positions

# ── Signal Thresholds ─────────────────────────────────────────────────
CVD_THRESHOLD=5.0           # Net BTC buy/sell imbalance to consider significant (in BTC)
WHALE_THRESHOLD=50000       # USD size to classify a single trade as a whale order
SIGNAL_COOLDOWN=60          # Min seconds between signals per timeframe

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_TOKEN=             # BotFather token (e.g. 123456:ABC-DEF...)
TELEGRAM_CHAT_ID=           # Your chat/channel ID (e.g. -100123456789)

# ── Polymarket Live Trading (only needed if PAPER_TRADING=false) ──────
POLY_PRIVATE_KEY=           # Polygon wallet private key (0x...)
POLY_API_KEY=               # Polymarket L2 API key
POLY_API_SECRET=            # Polymarket API secret
POLY_PASSPHRASE=            # Polymarket API passphrase
